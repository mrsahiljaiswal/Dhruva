NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/dhruva
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=info
SESSION_SECRET=dev-only-session-secret-change
CSRF_SECRET=dev-only-csrf-secret-change-me

# Creates the first admin, if that email does not exist yet, and logs the invite link
# when no email provider is configured. Replace these before a real deployment.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Administrator

# Gmail can deliver an invite to any address. Turn on 2-Step Verification, create an
# app password at https://myaccount.google.com/apppasswords, and paste it here.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=you@gmail.com
# EMAIL_SMTP_PASS=the-app-password
EMAIL_FROM=you@gmail.com

# Optional. Resend's free sender only delivers to your own address until a domain is verified.
# SENTRY_DSN=
# EMAIL_API_KEY=re_xxxxxxxx

# Resource files upload directly to S3 or Cloudinary. Leave these unset to write resources without files.
# STORAGE_DRIVER=s3
# STORAGE_BUCKET=dhruva-resources
# STORAGE_REGION=ap-south-1
# STORAGE_KEY=
# STORAGE_SECRET=
# STORAGE_ENDPOINT=
# STORAGE_DRIVER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
